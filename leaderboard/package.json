{
  "name": "horde-leaderboard",
  "version": "1.0.0",
  "description": "Global leaderboard API for Horde Survival",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply horde-leaderboard --local",
